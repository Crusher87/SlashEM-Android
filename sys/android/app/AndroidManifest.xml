<?xml version="1.0" encoding="utf-8"?>
<manifest
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:installLocation="auto">
	<!-- Only needed before Android 10; later versions use app-specific storage. -->
	<uses-permission
		android:name="android.permission.WRITE_EXTERNAL_STORAGE"
		android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.INTERNET"/>

	<application
		android:label="Slash'EM"
		android:icon="@drawable/icon"
		android:largeHeap="true"
		android:theme="@android:style/Theme"
		android:allowBackup="true"
		android:enableOnBackInvokedCallback="false">
		<!-- enableOnBackInvokedCallback="false" keeps the Back key working as
		     Escape inside the game on Android 16+. -->
		<activity
			android:name="com.tbd.SlashEM.SlashEM"
			android:exported="true"
			android:label="Slash'EM"
			android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
			android:launchMode="singleTask"
			android:configChanges="mcc|mnc|locale|keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|fontScale">
			<!-- Prevent activity from restarting when configuration changes -->
			<intent-filter>
				<action
					android:name="android.intent.action.MAIN"/>
				<category
					android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>
		</activity>
		<!-- Reopens the game after it closes, for "Play again". -->
		<activity
			android:name="com.tbd.SlashEM.RestartActivity"
			android:exported="false"
			android:process=":restart"
			android:theme="@android:style/Theme.Translucent.NoTitleBar"
			android:excludeFromRecents="true">
		</activity>
		<activity
			android:name="com.tbd.forkfront.Settings"
			android:exported="false"
			android:label="Slash'EM Settings">
		</activity>
	</application>
</manifest>
